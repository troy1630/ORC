SESSION_COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_SECRET=
